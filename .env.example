# ==============================================================================
# Coding Agent 环境变量配置模板
# 使用方法：复制本文件为 `.env` 后填入真实配置（切勿将 `.env` 提交到版本库）
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 主模型配置（兼容 OpenAI API 协议：DeepSeek / OpenAI / 智谱 GLM 等）
# 读取优先级：LLM_* > DEEPSEEK_* > OPENAI_* > ZHIPU_*
# ------------------------------------------------------------------------------
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat

# 可选厂商专属变量（未设置 LLM_* 时按优先级回退）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ------------------------------------------------------------------------------
# 2. 目标自驱动闭环（Goal Loop / M9）配置
# ------------------------------------------------------------------------------
# 独立目标评估器使用的模型 ID（留空则默认复用主模型 LLM_MODEL_ID）
# GOAL_EVALUATOR_MODEL_ID=

# Stop Hook 连续拦截熔断上限（达到后强制结束防止死循环，默认 8）
GOAL_BLOCK_CAP=8

# 单次 Agent Turn 最大工具循环轮数（默认 25）
MAX_TURNS=25
